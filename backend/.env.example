# ============================================
# Gestão Clínica - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.

# ── Banco de Dados ─────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Segurança ──────────────────────────────
JWT_SECRET_KEY=coloque-uma-chave-secreta-forte-aqui
APP_SECRET_KEY=coloque-outra-chave-secreta-aqui
APP_ENV=development

# ── Autenticação ────────────────────────────
APP_ADMIN_USER=admin
APP_ADMIN_PASS=sua_senha_aqui
APP_REQUIRE_AUTH=true

# ── Google Gemini AI ────────────────────────
GOOGLE_API_KEY=sua_chave_gemini_aqui
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite

# ── Google Docs ─────────────────────────────
# GOOGLE_DOCS_TEMPLATE_ID=seu_template_id_aqui

# ── Google OAuth (login social) ─────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Microsoft OAuth ─────────────────────────
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common

# ── Apple OAuth ─────────────────────────────
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_TEAM_ID=
# APPLE_OAUTH_KEY_ID=
# APPLE_OAUTH_PRIVATE_KEY=

# ── Frontend ────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Backend (para Vercel) ───────────────────
# BACKEND_URL=http://localhost:8000

# ── Logging ─────────────────────────────────
LOG_LEVEL=INFO
