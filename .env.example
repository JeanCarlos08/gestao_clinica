# Configurações da Clínica IA - TEMPLATE
# Renomeie este arquivo para .env e preencha com seus dados reais

# ── BANCO DE DADOS (PostgreSQL) ────────────────────────────────
DATABASE_URL=seu_postgres_url_aqui

# ── GOOGLE GEMINI AI ───────────────────────────────────────────
GOOGLE_API_KEY=sua_chave_api_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# ── N8N CLOUD ─────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://seu-workspace.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=seu_secret_opcional

# ── GOOGLE DOCS ───────────────────────────────────────────────
GOOGLE_DOCS_TEMPLATE_ID=id_do_seu_google_doc_template

# ── AUTENTICAÇÃO ──────────────────────────────────────────────
APP_ADMIN_USER=julianafeitosa
APP_ADMIN_PASS=hash_da_senha_aqui
APP_REQUIRE_AUTH=true

# ── SISTEMA ────────────────────────────────────────────────────
APP_NAME=mvpdepsicologia
APP_VERSION=2.0.0
APP_ENV=development
APP_SECRET_KEY=troque-esta-chave-em-producao
LOG_LEVEL=INFO

# ── SEGURANÇA ─────────────────────────────────────────────────
JWT_SECRET_KEY=gere_uma_chave_segura_aqui
