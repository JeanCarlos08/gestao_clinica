# ── BANCO DE DADOS (Neon PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ── GOOGLE GEMINI AI ────────────────────────────────────────────
GOOGLE_API_KEY=sua_api_key_do_google_gemini
GEMINI_MODEL=gemini-2.5-flash

# ── GOOGLE DOCS ────────────────────────────────────────────────
GOOGLE_DOCS_TEMPLATE_ID=id_do_seu_google_doc_template

# ── AUTENTICAÇÃO ───────────────────────────────────────────────
APP_ADMIN_USER=seu_usuario_admin
APP_ADMIN_PASS=sua_senha_segura
APP_REQUIRE_AUTH=true

# ── SISTEMA ─────────────────────────────────────────────────────
APP_NAME=Clínica IA
APP_VERSION=3.0.0
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-secure-random-key
LOG_LEVEL=INFO

# ── SEGURANÇA — JWT ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-secure-random-key

# ── SEGURANÇA — BRUTE FORCE ────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── LGPD — DPO (Encarregado de Dados) ─────────────────────────
DPO_EMAIL=dpo@suaorganizacao.com.br
DPO_NOME=Nome do Encarregado de Dados

# ── GOOGLE OAUTH (Login Social) ───────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-seu-client-secret

# ── MICROSOFT OAUTH (Login Social) ───────────────────────────
MICROSOFT_OAUTH_CLIENT_ID=seu-application-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=seu-client-secret
MICROSOFT_OAUTH_TENANT_ID=common

# ── APPLE OAUTH (Login Social) ───────────────────────────────
APPLE_OAUTH_CLIENT_ID=com.seuapp.login
APPLE_OAUTH_TEAM_ID=seu-team-id
APPLE_OAUTH_KEY_ID=seu-key-id
APPLE_OAUTH_PRIVATE_KEY=chave-private-key-p8

# ── FRONTEND URL ─────────────────────────────────────────────
FRONTEND_URL=https://seu-app.vercel.app

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=https://seu-app.vercel.app
