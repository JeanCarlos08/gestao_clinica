# Configurações da Clínica IA — TEMPLATE
# Renomeie este arquivo para .env e preencha com seus dados reais

# ── BANCO DE DADOS (PostgreSQL) ─────────────────────────────────
DATABASE_URL=seu_postgres_url_aqui

# ── GOOGLE GEMINI AI ────────────────────────────────────────────
GOOGLE_API_KEY=sua_chave_api_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# ── N8N CLOUD ──────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://seu-workspace.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=seu_secret_opcional

# ── GOOGLE DOCS ────────────────────────────────────────────────
GOOGLE_DOCS_TEMPLATE_ID=id_do_seu_google_doc_template
GOOGLE_CLOUD_PROJECT=seu-project-id
GOOGLE_SECRET_NAME=google-docs-sa-key

# ── CREDENTIALS SOURCE ─────────────────────────────────────────
# Opções: 'local' (arquivo), 'secret_manager', 'env', 'auto'
CREDENTIALS_SOURCE=auto
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=base64-encoded-json

# ── AUTENTICAÇÃO ───────────────────────────────────────────────
APP_ADMIN_USER=julianafeitosa
APP_ADMIN_PASS=01202268Jf!
APP_REQUIRE_AUTH=true

# ── SISTEMA ─────────────────────────────────────────────────────
APP_NAME=mvpdepsicologia
APP_VERSION=2.1.0
APP_ENV=development
APP_SECRET_KEY=troque-esta-chave-em-producao
LOG_LEVEL=INFO

# ── SEGURANÇA — JWT ────────────────────────────────────────────
JWT_SECRET_KEY=gere_uma_chave_segura_aqui
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"

# ── SEGURANÇA — CORS ───────────────────────────────────────────
# Lista de origens permitidas separadas por vírgula
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ── SEGURANÇA — BRUTE FORCE ────────────────────────────────────
# Bloqueia após N tentativas falhas na janela de X minutos
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── LGPD — DPO (Encarregado de Dados) ─────────────────────────
# Obrigatório pela LGPD Art. 41
DPO_EMAIL=dpo@suaorganizacao.com.br
DPO_NOME=Nome do Encarregado de Dados

# ── LGPD — SMTP (Alertas de incidente) ────────────────────────
# Configurar para receber alertas automáticos de incidentes de segurança
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app-gmail
INCIDENT_ALERT_EMAIL=dpo@suaorganizacao.com.br
