# ──────────────────────────────────────────────────────────────
# mvpdepsicologia — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados reais
# NUNCA commite o arquivo .env no git!
# ──────────────────────────────────────────────────────────────

# ── BANCO DE DADOS (PostgreSQL) ────────────────────────────────
# Opção 1: URL completa (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require

# Opção 2: Variáveis individuais (alternativa à URL)
# db_host=host
# db_port=5432
# db_name=nome_banco
# db_user=usuario
# db_password=senha
# db_sslmode=require

# ── GOOGLE GEMINI AI ───────────────────────────────────────────
GOOGLE_API_KEY=sua_chave_api_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ── N8N CLOUD ─────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://seu-workspace.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=seu_secret_opcional

# ── GOOGLE DOCS ───────────────────────────────────────────────
GOOGLE_DOCS_TEMPLATE_ID=id_do_seu_google_doc_template

# ── AUTENTICAÇÃO ──────────────────────────────────────────────
APP_ADMIN_USER=admin
APP_ADMIN_PASS=sua_senha_aqui
APP_REQUIRE_AUTH=true

# ── SISTEMA ────────────────────────────────────────────────────
APP_NAME=mvpdepsicologia
APP_VERSION=2.0.0
APP_ENV=development
APP_SECRET_KEY=troque-esta-chave-em-producao
LOG_LEVEL=INFO

# ── WHATSAPP (FUTURO) ──────────────────────────────────────────
# WHATSAPP_API_URL=https://api.evolution.com
# WHATSAPP_API_TOKEN=seu_token
