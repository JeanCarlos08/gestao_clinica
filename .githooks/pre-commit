#!/usr/bin/env bash
set -euo pipefail

# Block common sensitive files and folders before they reach the repository.
STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -Eq '(^|/)credentials\.json$'; then
  echo "ERROR: Attempt to commit credentials.json detected." >&2
  exit 1
fi

if echo "$STAGED" | grep -Eq '(^|/)\.env($|\.)|(^|/)backend/\.env($|\.)|(^|/)frontend/\.env($|\.)'; then
  echo "ERROR: Attempt to commit .env file detected. Use .env.example only." >&2
  exit 1
fi

if echo "$STAGED" | grep -Eq '(^|/)venv/|(^|/)\.venv/'; then
  echo "ERROR: Attempt to commit virtual environment files detected." >&2
  exit 1
fi

if echo "$STAGED" | grep -Eq '\.(pem|key|p12)$'; then
  echo "ERROR: Attempt to commit private key/certificate file detected." >&2
  exit 1
fi

exit 0
